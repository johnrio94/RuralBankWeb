@page
@model RuralBankWeb.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<section class="section">
    <div class="container">
        <div class="divider">Admin</div>
        <h1>Login</h1>

        @if (Model.ErrorMessage != null)
        {
            <p style="color:red;">@Model.ErrorMessage</p>
        }

        <form method="post" style="max-width:400px; margin-top:30px;">
            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" />
            </div>
            <div class="form-group" style="margin-top:15px;">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:20px;">Log In</button>
        </form>
    </div>
</section>
