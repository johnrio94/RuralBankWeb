@page
@model RuralBankWeb.Pages.AgriculturalLoansModel
@{
    ViewData["Title"] = "Agricultural Loans";
}

<section class="section">
    <div class="container">
        <div class="divider">Agricultural Loans</div>
        <h3>Growing Your Farm, Securing Your Future</h3>
        <p style="max-width:640px;">At Rural Bank of Norala, agriculture is at the heart of everything we do. We know that farming isn't just a business—it's a way of life that feeds our community and fuels our local economy.</p>
        <p style="max-width:640px;">Whether you need seasonal working capital for seeds and fertilizer, funding to upgrade your machinery, or capital to expand your livestock, our specialized agricultural loan programs offer flexible repayment terms tailored around your harvest season and competitive low interest rates.</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Watch &amp; Learn</div>
        <h3>See How We Support Local Producers</h3>
        <p style="max-width:640px;">From rice fields to fishing communities, our financing programs are built around the real rhythms of local livelihoods.</p>

        <div class="grid grid-2 video-showcase">
            <div class="card video-card">
                <video controls preload="metadata" poster="/img/agricultural.jpeg">
                    <source src="/video/agricultural-loans.mp4" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
                <h3>Agriculture</h3>
                <p class="video-caption">See how our harvest-aligned loans and crop financing help local farmers grow with confidence, season after season.</p>
            </div>

            <div class="card video-card">
                <video controls preload="metadata" poster="/img/fishery.jpeg">
                    <source src="/video/fishery.mp4" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
                <h3>Fishery</h3>
                <p class="video-caption">Discover how we support local fisherfolk with accessible credit, insurance access, and government-backed programs.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Our Loan Products</div>
        <h3>Credit Solutions for Every Stage of the Agricultural Cycle</h3>
        <p style="max-width:640px;">We offer a variety of credit solutions designed to match every stage of the agricultural cycle:</p>

        <table class="data-table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Loan Program</th>
                    <th>Best For</th>
                    <th>Key Benefits</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Crop Production Loan</strong></td>
                    <td>Rice, corn, sugarcane, vegetable, and fruit farmers</td>
                    <td>Short-term capital for seeds, fertilizers, pesticides, fuel, and labor.</td>
                </tr>
                <tr>
                    <td><strong>Farm Machinery &amp; Equipment Loan</strong></td>
                    <td>Farm owners &amp; cooperatives</td>
                    <td>Financing for tractors, harvesters, irrigation systems, and solar pumps.</td>
                </tr>
                <tr>
                    <td><strong>Livestock &amp; Poultry Loan</strong></td>
                    <td>Backyard and commercial raisers</td>
                    <td>Funding for breeding stock, feeds, housing construction, and veterinary care.</td>
                </tr>
                <tr>
                    <td><strong>Agri-Value Chain &amp; Enterprise Loan</strong></td>
                    <td>Wholesalers, processors, and traders</td>
                    <td>Capital for post-harvest facilities, cold storage, transport trucks, and milling.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Designed for the Rural Community</div>
        <h3>Built Around How Farming Actually Works</h3>

        <div class="grid grid-3" style="margin-top:40px;">
            <div class="card">
                <h3>Flexible Repayments</h3>
                <p>Matched with harvest seasons, not rigid monthly schedules.</p>
            </div>
            <div class="card">
                <h3>Affordable Rates</h3>
                <p>Low interest and fees tailored specifically for farmers.</p>
            </div>
            <div class="card">
                <h3>Government Backed</h3>
                <p>Crop insurance and credit guarantees to protect your investment.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Why Choose Us</div>
        <h3>Why Choose Rural Bank of Norala?</h3>

        <div class="grid grid-3" style="margin-top:40px;">
            <div class="card">
                <h3>Harvest-Aligned Terms</h3>
                <p>Pay back your loan when you sell your yield—choose from single-bullet payments upon harvest or quarterly schedules.</p>
            </div>
            <div class="card">
                <h3>Fast &amp; Simple Processing</h3>
                <p>Minimal paperwork with local officers who understand agricultural timelines.</p>
            </div>
            <div class="card">
                <h3>Integrated Crop Protection</h3>
                <p>We work directly with agricultural guarantee funds and crop insurance providers to protect your investment against natural disasters and pest infestations.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Requirements &amp; How to Apply</div>
        <h3>Getting Started Is Simple</h3>

        <div class="grid grid-2" style="margin-top:40px;">
            <div class="card">
                <h3>Basic Requirements</h3>
                <ul>
                    <li>Valid Government-Issued ID</li>
                    <li>Proof of Land Ownership (Title, Tax Declaration, or Lease Agreement)</li>
                    <li>Simple Farm Plan / Budget Estimate</li>
                    <li>Barangay Clearance or Farm Registration (if applicable)</li>
                </ul>
            </div>
            <div class="card">
                <h3>3 Easy Steps to Get Started</h3>
                <ol>
                    <li><strong>Visit or Contact Us:</strong> Drop by the Rural Bank of Norala or talk to one of our Account Officers.</li>
                    <li><strong>Farm Assessment:</strong> Our agricultural loan specialist will conduct a quick visit to inspect your farm and understand your needs.</li>
                    <li><strong>Approval &amp; Disbursal:</strong> Get fast approval and receive your funds right in time for the planting or buying season.</li>
                </ol>
            </div>
        </div>
    </div>
</section>