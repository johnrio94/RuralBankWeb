@page
@model CarFinancingModel
@{
    ViewData["Title"] = "Car Vehicle Financing";
}

<section class="section">
    <div class="container">
        <div class="divider">Car &amp; Vehicle Financing</div>
        <h3>Drive Your Business and Family Forward</h3>
        <p style="max-width:640px;">At Rural Bank of Norala, we understand that reliable transportation is essential—whether you need a personal vehicle for your family's daily needs, a motorcycle for quick errands, or heavy-duty vehicles to transport crops and cargo across the region.</p>
        <p style="max-width:640px;">Our Vehicle Financing Program offers affordable, low-interest loans tailored to meet the needs of individuals, farmers, and local business owners in our community.</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Financing Made Simple</div>
        <h3>Get Behind the Wheel, Sooner</h3>
        <p style="max-width:640px;">From family sedans to farm-ready pickups, our vehicle loans are built to get you moving—without the stress of complicated bank requirements.</p>
        
        <div class="image-showcase" style="margin-top:40px;">
            <div class="card image-card">
                <img src="/img/car_financing.jpeg" alt="Vehicle financing at Rural Bank of Norala" />
                <a href="/Contact" class="btn btn-primary" style="margin-top:10px;">Inquire Now</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Vehicle Financing Options</div>
        <h3>Flexible Terms Across a Wide Range of Vehicle Types</h3>

        <table class="data-table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Vehicle Type</th>
                    <th>Ideal For</th>
                    <th>Highlights</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Personal Vehicles</strong></td>
                    <td>Cars, SUVs, and Vans for personal or family use</td>
                    <td>Flexible down payment options &amp; affordable monthly terms.</td>
                </tr>
                <tr>
                    <td><strong>Commercial &amp; Utility Vehicles</strong></td>
                    <td>Light trucks, pickups, and cargo vans for trade and transport</td>
                    <td>Designed to help local enterprises and farmers deliver produce and goods efficiently.</td>
                </tr>
                <tr>
                    <td><strong>Motorcycles &amp; Tricycles</strong></td>
                    <td>Everyday personal transit or small delivery/hauling needs</td>
                    <td>Lower monthly payments with fast application processing.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Why Choose Us</div>
        <h3>Why Finance Your Vehicle with Us?</h3>

        <div class="grid grid-3" style="margin-top:40px;">
            <div class="card">
                <h3>Community-Focused Terms</h3>
                <p>We work directly with you to structure repayment schedules that fit your actual income cycles.</p>
            </div>
            <div class="card">
                <h3>Competitive Low Rates</h3>
                <p>Enjoy fair interest rates without the hidden charges often found with multi-branch commercial lenders.</p>
            </div>
            <div class="card">
                <h3>Personalized Service</h3>
                <p>Work directly with our local Account Officers who understand your needs and respect your time.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Requirements &amp; How to Apply</div>
        <h3>Getting on the Road Is Straightforward</h3>

        <div class="grid grid-2" style="margin-top:40px;">
            <div class="card">
                <h3>Basic Requirements</h3>
                <p>To help us process your application quickly, please prepare the following:</p>
                <ul>
                    <li>Valid Government-Issued IDs (Borrower and Co-maker, if applicable)</li>
                    <li>Proof of Income / Financial Capability (e.g., Pay slips, Certificate of Employment, Bank Statements, or Farm/Business Income records)</li>
                    <li>Price Quotation of the vehicle from an accredited dealer</li>
                    <li>Barangay Clearance / Proof of Billing Address</li>
                </ul>
            </div>
            <div class="card">
                <h3>How to Apply</h3>
                <ol>
                    <li><strong>Visit Us:</strong> Drop by the Rural Bank of Norala head office or talk to our Account Officers.</li>
                    <li><strong>Submit Your Documents:</strong> Present your vehicle quotation and basic requirements for assessment.</li>
                    <li><strong>Drive Away:</strong> Once approved, we will assist with the loan release so you can take delivery of your vehicle.</li>
                </ol>
            </div>
        </div>
    </div>
</section>