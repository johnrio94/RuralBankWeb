@page
@* @model RuralBankWeb.Pages.AnnualReportModel *@
@model AnnualReportModel

@{
    ViewData["Title"] = "Annual Report and Governance";
}

<section class="section">
    <div class="container">
        <div class="divider">Annual Report &amp; Governance</div>
        <h3>Transparency, Integrity, and Sound Management</h3>
        <p style="max-width:640px;">At Rural Bank of Norala, our commitment to corporate governance goes beyond regulatory compliance—it is the foundation of the trust our depositors, agricultural partners, and community place in us every day.</p>
        <p style="max-width:640px;">We operate under strict risk management frameworks, clear ethical guidelines, and prudent financial management to ensure the long-term safety and soundness of our bank.</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Corporate Governance Framework</div>
        <h>Managed Responsibly, Transparently, and in Compliance</h>
        <p style="max-width:640px;">Our governance policy ensures that the bank is managed responsibly, transparently, and in alignment with the guidelines set by the Bangko Sentral ng Pilipinas (BSP) and the Philippine Deposit Insurance Corporation (PDIC).</p>

        <h3 style="margin-top:30px;">Core Pillars of Our Leadership</h3>
        <div class="grid grid-3" style="margin-top:20px;">
            <div class="card">
                <h3>Board Oversight</h3>
                <p>Strategic direction and independent risk assessment by an experienced Board of Directors with deep roots in local agriculture and community development.</p>
            </div>
            <div class="card">
                <h3>Risk Management &amp; Compliance</h3>
                <p>Proactive risk mitigation policies, internal audits, and full compliance with anti-money laundering (AML) and financial privacy laws.</p>
            </div>
            <div class="card">
                <h3>Consumer Protection</h3>
                <p>Fair, transparent, and respectful treatment of every client, ensuring full disclosure of loan terms, fees, and deposit rights.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Annual Reports &amp; Financial Disclosures</div>
        <h3>Clear Visibility Into Our Financial Performance</h3>
        <p style="max-width:640px;">We publish our annual financial statements and governance reports to provide our shareholders, clients, and partners with clear visibility into our financial performance and operational growth.</p>

        <table class="data-table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Publication Year</th>
                    <th>Document Title</th>
                    <th>Format</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>2025</strong></td>
                    <td>2025 Annual Report &amp; Financial Statements</td>
                    <td><a href="/documents/annual-report-2025.pdf" class="btn btn-sm" target="_blank" rel="noopener">Download PDF</a></td>
                </tr>
                <tr>
                    <td><strong>2024</strong></td>
                    <td>2024 Annual Report &amp; Audited Financial Statement</td>
                    <td><a href="/documents/annual-report-2024.pdf" class="btn btn-sm" target="_blank" rel="noopener">Download PDF</a></td>
                </tr>
                <tr>
                    <td><strong>2023</strong></td>
                    <td>2023 Annual Report &amp; Audited Financial Statement</td>
                    <td><a href="/documents/annual-report-2023.pdf" class="btn btn-sm" target="_blank" rel="noopener">Download PDF</a></td>
                </tr>
            </tbody>
        </table>

        <p style="margin-top:20px; font-size:0.9rem; color:var(--color-soil);"><em>Note: Physical copies of audited financial reports are available for review by shareholders upon request at our main office.</em></p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Leadership</div>
        <h3>Board of Directors &amp; Management</h3>
        <p style="max-width:640px;">Our leadership team brings together decades of experience in rural banking, local governance, and agricultural finance:</p>

        <div class="grid grid-3" style="margin-top:30px;">
            <div class="card">
                <h3>Board of Directors</h3>
                <p>Responsible for high-level policy, risk governance, and long-term strategy.</p>
            </div>
            <div class="card">
                <h3>Executive Officers</h3>
                <p>Oversee day-to-day branch operations, loan disbursements, and customer services.</p>
            </div>
            <div class="card">
                <h3>Internal Audit &amp; Compliance Team</h3>
                <p>Ensures total adherence to banking standards and financial reporting accuracy.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Regulatory Standards &amp; Protections</div>
        <h3>Backed by National Regulatory Bodies</h3>

        <div class="grid grid-2" style="margin-top:30px;">
            <div class="card" style="text-align:center;">
                <h3>Supervised by the BSP</h3>
                <p>Bangko Sentral ng Pilipinas oversees our operations to ensure sound banking practices.</p>
                <p style="margin-top:10px;"><a href="https://www.bsp.gov.ph" target="_blank" rel="noopener">www.bsp.gov.ph</a></p>
            </div>
            <div class="card" style="text-align:center;">
                <h3>Insured by the PDIC</h3>
                <p>Deposits are insured up to ₱500,000 per depositor by the Philippine Deposit Insurance Corporation.</p>
                <p style="margin-top:10px;"><a href="https://www.pdic.gov.ph" target="_blank" rel="noopener">www.pdic.gov.ph</a></p>
            </div>
        </div>
    </div>
</section>