@page
@model PartnerModel
@{
    ViewData["Title"] = "Partners";
}

<section class="section">
    <div class="container">
        <div class="divider">Our Partners</div>
        <h3>Stronger Together for Our Community</h3>
        <p style="max-width:840px;">At Rural Bank of Norala Inc., we believe that true community growth happens through collaboration. For decades, our mission has been to empower local farmers, small business owners, and families across our region.</p>
        <p style="max-width:840px;">To deliver the best financial services, modern banking technology, and sustainable development programs, we work alongside trusted national institutions, government agencies, and technology innovators. Together with our partners, we are building a more inclusive and resilient financial future for our community.</p>
    </div>
</section>

