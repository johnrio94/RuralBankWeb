@page
@model AccountOpen
@{
    ViewData["Title"] = "Account Opening";
}

<section class="section">
    <div class="container">
        <div class="divider">Open an Account</div>
        <h3>What You Need to Bring (Requirements)</h3>
        <p style="max-width:640px;">To comply with banking regulations and keep your account safe, please prepare the following valid documents before visiting us:</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="grid grid-3" style="align-items:start;">
            <div class="card">
                <h3>1. Primary Identification</h3>
                <p style="font-size:0.9rem; color:var(--color-soil);">Bring at least 1 Original &amp; Copy</p>
                <ul>
                    <li>Philippine Identification Card (PhilID / ePhilID)</li>
                    <li>Passport</li>
                    <li>Driver's License</li>
                    <li>UMID / SSS / GSIS Card</li>
                    <li>PRC License</li>
                    <li>Voter's ID / Voter's Certification</li>
                    <li>Postal ID</li>
                </ul>
                <p style="font-size:0.9rem; margin-top:15px;"><em>For students or minors: School ID with current enrollment photo and Birth Certificate.</em></p>
            </div>

            <div class="card">
                <h3>2. Proof of Address</h3>
                <p style="font-size:0.9rem; color:var(--color-soil);">Bring 1 document</p>
                <ul>
                    <li>Latest Electric, Water, or Internet Bill (past 3 months)</li>
                    <li>Barangay Certificate of Residency</li>
                </ul>
            </div>

            <div class="card">
                <h3>3. Photos &amp; Initial Deposit</h3>
                <ul>
                    <li>Two (2) recent 2x2 ID photos</li>
                    <li>Initial opening deposit amount (varies by account type)</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">How to Get Started</div>
        <h3>3 Simple Steps to Open Your Account</h3>

        <div class="grid grid-3" style="margin-top:40px;">
            <div class="card">
                <h3>1. Prepare Your Documents</h3>
                <p style="font-size:0.9rem; color:var(--color-soil); font-weight:600;">Before your visit</p>
                <p>Gather your valid government-issued ID, proof of address, 2x2 photos, and initial deposit money.</p>
            </div>
            <div class="card">
                <h3>2. Visit Our Main Office</h3>
                <p style="font-size:0.9rem; color:var(--color-soil); font-weight:600;">In-person assistance</p>
                <p>Drop by the Rural Bank of Norala main office. Our Customer Service Officers will assist you in filling out the Customer Information Sheet (CIS) and selecting the best account for your needs.</p>
            </div>
            <div class="card">
                <h3>3. Claim Your Passbook &amp; Start Saving</h3>
                <p style="font-size:0.9rem; color:var(--color-soil); font-weight:600;">Same-day setup</p>
                <p>Submit your forms, make your initial deposit at the teller counter, and receive your new passbook or account documents on the same day.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Deposit Protection</div>
        <h3>Your Money is Safe with Us</h3>
        <p style="max-width:640px;">Deposits are insured by the Philippine Deposit Insurance Corporation (PDIC) up to ₱500,000 per depositor. Rural Bank of Norala is proudly supervised by the Bangko Sentral ng Pilipinas (BSP).</p>
    </div>
</section>
