@page
@model AgriRes
@{
    ViewData["Title"] = "Agricultural Resources";
}

<section class="section">
    <div class="container">
        <div class="divider">Agricultural Resources &amp; Farmer Support</div>
        <h3>Empowering Local Farmers with Knowledge, Tools, and Support</h3>
        <p style="max-width:640px;">At Rural Bank of Norala, our partnership with agriculture goes far beyond loans and financial services. We know that sustainable farming requires access to market insights, modern agricultural techniques, climate preparedness, and government support programs.</p>
        <p style="max-width:640px;">We have compiled this resource center to help local farmers, livestock raisers, and agri-entrepreneurs in South Cotabato make informed decisions, improve crop yields, and protect their livelihoods.</p>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Government Support &amp; Crop Insurance</div>
        <h3>Protecting Your Farm Against Uncertainty</h3>
        <p style="max-width:640px;">Protecting your farm against natural disasters, climate uncertainties, and pest infestations is essential to long-term stability.</p>

        <table class="data-table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Resource / Program</th>
                    <th>What It Offers</th>
                    <th>How We Assist You</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>PCIC Crop Insurance</strong><br /><span style="font-size:0.85rem; color:var(--color-soil);">Philippine Crop Insurance Corp.</span></td>
                    <td>Insurance coverage for agricultural crops (rice, corn, high-value crops), livestock, and agricultural machinery.</td>
                    <td>We assist our loan borrowers in enrolling their crops and assets directly into PCIC insurance programs.</td>
                </tr>
                <tr>
                    <td><strong>DA-RSBSA Registration</strong><br /><span style="font-size:0.85rem; color:var(--color-soil);">Registry System for Basic Sectors in Agriculture</span></td>
                    <td>Official registration for farmers and fisherfolk to qualify for government subsidies, seed assistance, and fertilizer vouchers.</td>
                    <td>Our Account Officers guide clients on registration requirements and local DA office processing.</td>
                </tr>
                <tr>
                    <td><strong>Agricultural Credit Policy Council (ACPC)</strong></td>
                    <td>Government credit policies and special low-interest financing frameworks for smallholder farmers.</td>
                    <td>We partner with government credit programs to extend subsidized loan options to local agricultural producers.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Seasonal Farming &amp; Harvest Guides</div>
        <h3>Plan Your Season From Planting to Payout</h3>

        <div class="grid grid-3" style="margin-top:30px;">
            <div class="card">
                <h3>1. Planting Season</h3>
                <p>Apply for seasonal inputs &amp; crop credit.</p>
            </div>
            <div class="card">
                <h3>2. Mid-Season Care</h3>
                <p>Monitor weather &amp; manage pest risks.</p>
            </div>
            <div class="card">
                <h3>3. Harvest &amp; Sale</h3>
                <p>Sell yield, settle loan, reinvest savings.</p>
            </div>
        </div>

        <h3 style="margin-top:40px;">Best Practices for Financial Planning</h3>
        <div class="grid grid-3" style="margin-top:20px;">
            <div class="card">
                <h3>Match Credit to Harvest Timelines</h3>
                <p>Ensure your loan maturity date aligns directly with your expected harvest and buyer payout schedules to avoid unnecessary penalties.</p>
            </div>
            <div class="card">
                <h3>Diversify Crops &amp; Revenue</h3>
                <p>Explore intercropping or adding small livestock/poultry to maintain consistent cash flow between major harvest cycles.</p>
            </div>
            <div class="card">
                <h3>Set Aside Reserve Capital</h3>
                <p>Build an emergency fund or keep a Time Deposit / Savings Account to buffer against unexpected weather delays or price drops.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Local Agricultural Contacts</div>
        <h3>Useful Links &amp; Regional Resources</h3>
        <p style="max-width:640px;">Stay connected with regional agricultural authorities and local resources:</p>

        <div class="grid grid-3" style="margin-top:30px;">
            <div class="card">
                <h3>Municipal Agriculture Office (MAO) – Norala</h3>
                <p><strong>Focus:</strong> Local seed distribution, soil testing, and farming technology updates.</p>
                <p><strong>Location:</strong> Municipal Hall Compound, Norala, South Cotabato</p>
            </div>
            <div class="card">
                <h3>Department of Agriculture (DA) – Region XII</h3>
                <p><strong>Focus:</strong> Regional crop advisories, market price monitoring, and farming grants.</p>
                <p>Contact your local DA field office for the latest advisories and grant application details.</p>
            </div>
            <div class="card">
                <h3>PAGASA Weather &amp; Climate Bulletins</h3>
                <p><strong>Focus:</strong> Seasonal rainfall outlook, typhoon advisories, and El Niño/La Niña forecasts.</p>
                <p><a href="https://www.pagasa.dost.gov.ph" target="_blank" rel="noopener">pagasa.dost.gov.ph</a></p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Financing Support</div>
        <h3>Agri-Loan Assistance at Rural Bank of Norala</h3>
        <p style="max-width:640px;">Need financing to apply modern farming techniques or expand your agricultural enterprise?</p>

        <div class="grid grid-3" style="margin-top:30px;">
            <div class="card">
                <h3>Crop Production Loans</h3>
                <p>Rice, Corn, Sugarcane, Vegetables</p>
                <a href="/AgriculturalLoans" class="btn btn-sm" style="margin-top:10px;">Learn More</a>
            </div>
            <div class="card">
                <h3>Farm Equipment &amp; Solar Irrigation Loans</h3>
                <p>Machinery, tractors, and solar-powered irrigation systems</p>
                <a href="/AgriculturalLoans" class="btn btn-sm" style="margin-top:10px;">Learn More</a>
            </div>
            <div class="card">
                <h3>Livestock &amp; Poultry Financing</h3>
                <p>Breeding stock, feeds, housing, and veterinary care</p>
                <a href="/AgriculturalLoans" class="btn btn-sm" style="margin-top:10px;">Learn More</a>
            </div>
        </div>
    </div>
</section>