@page
@model SolarEnergy
@{
    ViewData["Title"] = "Solar Energy Financing";
}

<section class="section vehicle-hero">
    <div class="container vehicle-hero-grid">
        <div class="vehicle-hero-copy">
            <div class="divider">Solar Energy Financing</div>
            <h3>Power Your Farm, Business, and Home with Green Energy</h3>
            <p>High electricity bills and power interruptions shouldn't slow down your operations or stress your household. At Rural Bank of Norala, we offer specialized Solar Energy Loans to help farmers, local business owners, and homeowners adopt clean, cost-effective solar technology.</p>
            <p>Invest in renewable energy today to cut your monthly power expenses and ensure uninterrupted electricity when you need it most.</p>
        
        </div>
        <div class="solar-hero-media">
            <img src="/img/solar.jpg" alt="RBN's Green Home &amp; Solar Energy Financing" />
            <a href="/Contact" class="btn btn-primary" style="margin-top:10px;">Inquire Now</a>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Solar Solutions We Finance</div>
        <h3>Flexible Capital for Every Solar Application</h3>
        <p style="max-width:640px;">Whether you are looking to lower household power bills or automate farm irrigation, we provide flexible capital for:</p>

        <table class="data-table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Best For</th>
                    <th>Key Benefits</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Agricultural Solar Pumps</strong></td>
                    <td>Rice, vegetable, and livestock farmers</td>
                    <td>Eliminates high fuel and grid costs for irrigation systems.</td>
                </tr>
                <tr>
                    <td><strong>Commercial Solar Systems</strong></td>
                    <td>Rice mills, cold storage, stores, &amp; local businesses</td>
                    <td>Offsets heavy daytime electricity costs and boosts profit margins.</td>
                </tr>
                <tr>
                    <td><strong>Residential Solar Panels</strong></td>
                    <td>Homeowners &amp; residential properties</td>
                    <td>Reduces family electricity bills and provides reliable backup power.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="divider">Why Choose Us</div>
        <h3>Why Choose Rural Bank of Norala for Solar Financing?</h3>

        <div class="grid grid-3" style="margin-top:40px;">
            <div class="card">
                <h3>Self-Paying Investment</h3>
                <p>The savings on your monthly electric bill or diesel costs can directly help pay off your monthly loan installments.</p>
            </div>
            <div class="card">
                <h3>Harvest &amp; Income-Aligned Terms</h3>
                <p>Flexible payment schedules matched to your crop cycles or business cash flow.</p>
            </div>
            <div class="card">
                <h3>Local, Hassle-Free Processing</h3>
                <p>Work directly with our local Account Officers who ensure quick evaluations and straightforward approvals.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="divider">Requirements &amp; How to Apply</div>
        <h3>Getting Started Is Straightforward</h3>

        <div class="grid grid-2" style="margin-top:40px;">
            <div class="card">
                <h3>Basic Requirements</h3>
                <p>To get started with your solar financing application, please prepare:</p>
                <ul>
                    <li>Valid Government-Issued IDs (Borrower and Co-maker, if applicable)</li>
                    <li>Proof of Income (Pay slips, ITR, Business Permit, or Farm/Agri Income records)</li>
                    <li>Latest Electric Utility Bill (Past 3 months)</li>
                    <li>Solar System Quotation from your chosen solar equipment supplier/installer</li>
                    <li>Barangay Clearance &amp; Proof of Residence</li>
                </ul>
            </div>
            <div class="card">
                <h3>How to Apply</h3>
                <ol>
                    <li><strong>Get a Solar Estimate:</strong> Obtain an official quotation from a qualified solar supplier for your home, farm, or business.</li>
                    <li><strong>Visit Us:</strong> Drop by the Rural Bank of Norala main office or talk to our Account Officers to submit your quotation and documents.</li>
                    <li><strong>Energize &amp; Save:</strong> Once approved, we disburse funds directly to get your solar system installed and running.</li>
                </ol>
            </div>
        </div>
    </div>
</section>