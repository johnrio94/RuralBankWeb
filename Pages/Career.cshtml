@page
@model CareerModel
@{
    ViewData["Title"] = "Careers";
}

<section class="section">
    <div class="container">
        <div class="divider">Careers</div>
        <h3>@(Model.Hero?.Heading ?? "Build your career with us.")</h3>
        <p style="max-width:640px;">@(Model.Hero?.Body ?? "We're a community-focused bank looking for people who care about service, integrity, and helping our members grow.")</p>
        <div class="grid grid-2" style="margin-top:40px;">
            <div class="card">
                <h3>Why work here</h3>
                <p>Competitive pay, HMO coverage, government-mandated benefits, and a supportive team culture rooted in community service.</p>
            </div>
            <div class="card">
                <h3>Growth &amp; training</h3>
                <p>Structured onboarding, ongoing skills training, and internal promotion pathways for employees who want to grow with the bank.</p>
            </div>
        </div>

        <h3 style="margin-top:50px;">Current Openings</h3>
        <table class="data-table" style="margin-top:20px;">
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Department</th>
                    <th>Location</th>
                    <th>Employment Type</th>
                    <th></th>
                </tr>
            </thead>
            @* <tbody>
                <tr>
                    <td><strong>Branch Teller</strong></td>
                    <td>Branch Operations</td>
                    <td>Main Branch</td>
                    <td>Full-time</td>
                </tr>
                <tr>
                    <td><strong>Loan Officer</strong></td>
                    <td>Credit &amp; Lending</td>
                    <td>Main Branch</td>
                    <td>Full-time</td>
                </tr>
                <tr>
                    <td><strong>Marketing Assistant</strong></td>
                    <td>Marketing</td>
                    <td>Head Office</td>
                    <td>Full-time</td>
                </tr>
                <tr>
                    <td><strong>IT Support Specialist</strong></td>
                    <td>Information Technology</td>
                    <td>Head Office</td>
                    <td>Full-time</td>
                </tr>
                <tr>
                    <td><strong>Compliance Officer</strong></td>
                    <td>Legal &amp; Compliance</td>
                    <td>Head Office</td>
                    <td>Full-time</td>
                </tr>
            </tbody> *@

            <tbody>
    @foreach (var job in Model.OpenPositions)
    {
        <tr>
            <td><strong>@job.Title</strong></td>
            <td>@job.Department</td>
            <td>@job.Location</td>
            <td>@job.EmploymentType</td>
            <td>
                <a href="/Apply?jobId=@job.Id" class="btn btn-primary btn-sm">Apply</a>
            </td>
        </tr>
    }
    @if (!Model.OpenPositions.Any())
    {
        <tr><td colspan="5">No current openings. Check back soon!</td></tr>
    }
</tbody>
 
        </table>

        <div class="grid grid-2" style="margin-top:40px;">
            <div class="card"
                <h3>How to apply</h3>
                <p>Send your resume and a short cover letter to <strong>careers@yourbank.com</strong>, or drop off a printed application at any branch. Qualified applicants will be contacted for an initial interview.</p>
            </div>
            <div class="card">
                <h3>What to prepare</h3>
                <p>Updated resume, valid government ID, transcript of records or diploma, and NBI clearance (for shortlisted applicants).</p>
            </div>
        </div>
    </div>
</section>

