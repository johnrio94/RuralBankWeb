@page
@model RuralBankWeb.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}

<section class="section">
    <div class="container">
        <div class="divider">Get in touch</div>
        <h1>Contact Us</h1>
        <p style="max-width:640px;">Have a question about a loan, deposit account, or listed asset? Send us a message or visit our branch below.</p>

        <div class="contact-grid" style="margin-top:36px;">
            <div>
                <h2>Our Branch</h2>

                <div class="branch-card">
                    <strong>Rural Bank of Norala (S. Cotabato), Inc.</strong>
                    <p>
                        Manuel Roxas Avenue, Corner Jose Burgos Street,<br />
                        Norala, South Cotabato, Philippines 9508<br />
                        📞 0912 461 4273
                    </p>
                </div>

                <p style="margin-top:20px;">General inquiries: <a href="mailto:rbnorala043450@gmail.com">rbnorala043450@gmail.com</a></p>
            </div>

            <div class="card">
                @if (Model.Submitted)
                {
                    <div class="contact-success">
                        <div class="contact-success-icon">✓</div>
                        <h2>Message Sent</h2>
                        <p>Thank you — your message has been received. A staff member will get back to you shortly.</p>
                        <a href="/Contact" class="btn btn-outline" style="margin-top:16px;">Send Another Message</a>
                    </div>
                }
                else
                {
                    <h2>Send a Message</h2>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="contact-error">
                            <p>@Model.ErrorMessage</p>
                        </div>
                    }

                    <form method="post">
                        <div class="form-field">
                            <label asp-for="Form.FullName">Full Name</label>
                            <input asp-for="Form.FullName" type="text" placeholder="Juan Dela Cruz" />
                            <span asp-validation-for="Form.FullName" class="field-error"></span>
                        </div>
                        <div class="form-field">
                            <label asp-for="Form.Phone">Phone Number</label>
                            <input asp-for="Form.Phone" type="tel" placeholder="0917 000 0000" />
                            <span asp-validation-for="Form.Phone" class="field-error"></span>
                        </div>
                        <div class="form-field">
                            <label asp-for="Form.Email">Email Address</label>
                            <input asp-for="Form.Email" type="email" placeholder="you@example.com" />
                            <span asp-validation-for="Form.Email" class="field-error"></span>
                        </div>
                        <div class="form-field">
                            <label asp-for="Form.Message">Message</label>
                            <textarea asp-for="Form.Message" rows="5" placeholder="How can we help you?"></textarea>
                            <span asp-validation-for="Form.Message" class="field-error"></span>
                        </div>
                        <button type="submit" class="btn btn-gold">Send Message</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>