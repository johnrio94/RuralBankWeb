@page
@model LocNews
@{
    ViewData["Title"] = "Local News";
}

<section class="section">`
    <div class="container">
        <div class="divider">Local News</div>
        <h1>Local News</h1>
        <p style="max-width:640px;">Whether you're financing this year's planting, growing a small business, or covering a family need, we have a loan product built around how rural income actually works.</p>

        <div class="grid grid-3" style="margin-top:36px;">
            <div class="product-card">
                <h3>Agricultural Production Loan</h3>
                <div class="rate">8.5% <span>per annum</span></div>
                <p>For seed, fertilizer, and labor costs, with repayment timed to harvest.</p>
                <ul>
                    <li>Up to ₱200,000</li>
                    <li>Flexible harvest-based terms</li>
                    <li>Land title or crop as collateral</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
            <div class="product-card">
                <h3>Small Business Loan</h3>
                <div class="rate">10% <span>per annum</span></div>
                <p>Working capital for sari-sari stores, trading, and other local enterprises.</p>
                <ul>
                    <li>Up to ₱500,000</li>
                    <li>12 to 36 month terms</li>
                    <li>Simple documentary requirements</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
            <div class="product-card">
                <h3>Salary &amp; Pension Loan</h3>
                <div class="rate">1.5% <span>per month</span></div>
                <p>For employees and pensioners, released within 2 banking days.</p>
                <ul>
                    <li>Up to 3x monthly income</li>
                    <li>Auto-deduction payment</li>
                    <li>Minimal requirements</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
            <div class="product-card">
                <h3>Farm Equipment Loan</h3>
                <div class="rate">9% <span>per annum</span></div>
                <p>Finance a hand tractor, thresher, or irrigation pump.</p>
                <ul>
                    <li>Up to 70% of equipment cost</li>
                    <li>Up to 5-year term</li>
                    <li>Equipment serves as collateral</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
            <div class="product-card">
                <h3>Livestock &amp; Poultry Loan</h3>
                <div class="rate">9.5% <span>per annum</span></div>
                <p>For hog, poultry, or cattle raising and fattening projects.</p>
                <ul>
                    <li>Up to ₱150,000</li>
                    <li>Cycle-based repayment</li>
                    <li>Technical guidance available</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
            <div class="product-card">
                <h3>Housing Improvement Loan</h3>
                <div class="rate">11% <span>per annum</span></div>
                <p>Repair or expand your family home.</p>
                <ul>
                    <li>Up to ₱300,000</li>
                    <li>Up to 7-year term</li>
                    <li>Title or co-maker required</li>
                </ul>
                <a class="btn btn-forest" href="/Contact" style="margin-top:6px;">Inquire</a>
            </div>
        </div>

        <p style="margin-top:32px; font-size:0.85rem; color:rgba(74,55,40,0.65);">Rates shown are indicative and subject to change based on credit evaluation, collateral, and prevailing bank policy. Visit any branch for a formal quotation.</p>
    </div>
</section>



